# API Configuration
# Backend API URL. Leave empty for production to use relative URLs (same origin).
# For development with a separate backend server, set this to the backend URL.
# Examples:
#   Development (local backend):  http://localhost:8000
#   Production (same origin):     (leave empty)
#   Staging:                      https://api-staging.example.com
VITE_API_BASE_URL=http://localhost:8000
