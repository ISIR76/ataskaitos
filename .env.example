# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development

# CORS Configuration
# Allowed origins for frontend requests (comma-separated list or JSON array format)
# ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# JWT Configuration
# Generate a secure JWT secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your_secure_jwt_secret_here
JWT_LIFETIME_SECONDS=3600

# CORS Max-Age (cache duration for preflight requests in seconds)
CORS_MAX_AGE_SECONDS=3600

# API Configuration
API_VERSION=0.2.0
SERVICE_NAME=ataskaitos-api

# Model Configuration
DEFAULT_ARTICLE_MODEL=openai:gpt-4o
DEFAULT_REPORT_MODEL=openai:gpt-4o
DEFAULT_MTEP_MODEL=openai:gpt-4o
DEFAULT_TEMPERATURE=0.0

# Evaluation Configuration
BATCH_EVALUATION_CONCURRENCY=5