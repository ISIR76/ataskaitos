# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore, with the addition of
# "#!include" directives (which insert the entries of the given .gitignore-style
# file at that point).
#
# For more information, run:
#   $ gcloud topic gcloudignore
#
.gcloudignore
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files (use --update-secrets instead)
.env
.env.local
.env.*.local

# Documentation
docs/
*.md
!README.md

# Test files
tests/
test_*.py
*_test.py

# Evaluation results and datasets (large files)
*_evaluation_results*.json
*_dataset.json
*_results.csv
combined_*.csv
temp_*.json

# Reference documents
*.docx
straipsniai/

# Deployment scripts
deploy*.sh
cloudbuild.yaml

# Claude config
CLAUDE.md

# Frontend build artifacts (will be built in container)
frontend/node_modules/
frontend/dist/
frontend/.turbo/
frontend/.next/
frontend/.cache/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Keep only essential files for Cloud Build
!Dockerfile
!pyproject.toml
!uv.lock
!frontend/package*.json
